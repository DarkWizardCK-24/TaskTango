# Public Firebase web config (not secret). Copy to .env.local and fill in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: named Firestore database (defaults to "(default)")
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=
# Optional: set to true to use local emulators (auth 9199, firestore 8180)
NEXT_PUBLIC_USE_EMULATOR=
